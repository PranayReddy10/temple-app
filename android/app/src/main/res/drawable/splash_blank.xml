<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ always draws an icon on its launch screen. This is an empty
     one, so that screen is only the teak background and flows straight into
     the temple doors instead of flashing the launcher icon first. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
