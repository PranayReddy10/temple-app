# darshansaathi.com: the devotees' website (this Flutter web build).
#
# On Hostinger the Laravel project sits beside it, at public_html/laravel,
# served as temple.darshansaathi.com (document root laravel/public).
# The app's page first. Hostinger drops a placeholder (default.php /
# index.php) into a new site's public_html, and the server's own order
# would open that instead of the app.
DirectoryIndex index.html

Options -Indexes
RewriteEngine On

# Nothing of the Laravel project is reachable by its folder name.
RewriteCond %{THE_REQUEST} \s/+laravel(/|\s|\?) [NC]
RewriteRule ^ - [R=404,L]

# Pages search engines read: the Flutter app is a blank page to them, so the
# temple directory, the temple and state pages and the sitemap are rendered
# by Laravel, which answers them on this domain too. /storage is where those
# pages' photos are served from.
RewriteRule ^(temples(/.*)?|states/.+|sitemap[^/]*\.xml|storage/.+)$ laravel/public/index.php [L,QSA]
