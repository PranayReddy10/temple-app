# darshansaathi.com: the devotees' website (this Flutter web build).
#
# On Hostinger the Laravel project sits beside it, at public_html/laravel,
# served as temple.darshansaathi.com (document root laravel/public).
# The app's page first. Hostinger drops a placeholder (default.php /
# index.php) into a new site's public_html, and the server's own order
# would open that instead of the app.
DirectoryIndex index.html

# Any address that is not found shows the site's own 404 page (the gopuram
# with closed doors, and temples the address may have meant) rather than
# the host's plain one.
ErrorDocument 404 /laravel/public/index.php

Options -Indexes

# The web engine (canvaskit/*.wasm) must be served as application/wasm:
# browsers compile it straight from the download only with that type, and
# some refuse it otherwise ("Incorrect response MIME type"). Shared hosts
# often do not know the extension.
<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType text/javascript .mjs
</IfModule>
# Caching. The page, its loader and the compiled app are checked on every
# visit (a cheap 304 when unchanged), so a deploy reaches everyone at once;
# the engine and the bundled fonts and sounds are kept for a day, so a
# returning devotee does not download several MB again.
<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|flutter_bootstrap\.js|flutter\.js|main\.dart\.js|version\.json|manifest\.json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(wasm|ttf|otf|wav|mp3|png|jpg|webp)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

# Compressed on the way out: the engine and the app shrink to about a third.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/javascript application/javascript application/json application/wasm
</IfModule>

RewriteEngine On

# Nothing of the Laravel project is reachable by its folder name.
RewriteCond %{THE_REQUEST} \s/+laravel(/|\s|\?) [NC]
RewriteRule ^ - [R=404,L]

# Pages search engines read: the Flutter app is a blank page to them, so the
# temple directory, the temple, state and deity pages and the sitemap are
# rendered by Laravel, which answers them on this domain too. /storage is
# where those pages' photos are served from, and google*.html is Search
# Console's check (the file name is set in Admin > Analytics & SEO).
RewriteRule ^(temples(/.*)?|states/.+|deities/.+|sitemap[^/]*\.xml|storage/.+|google[0-9a-f]+\.html)$ laravel/public/index.php [L,QSA]

# Opening temple links in the installed app: Android's assetlinks.json and
# iOS's apple-app-site-association, built by Laravel from the settings in
# Admin > App control. And IndexNow's key file, which proves to Bing and
# others that the pings telling them about new temples come from this site.
RewriteRule ^(\.well-known/(assetlinks\.json|apple-app-site-association)|apple-app-site-association|[0-9a-f]{32}\.txt)$ laravel/public/index.php [L,QSA]

# Policy and information pages (privacy-policy, terms-and-conditions,
# refund-and-cancellation, account-deletion, contact-us ...), edited in the
# admin panel under Website > Pages: any one-word address that is not a
# file or folder of this build. Unknown ones get Laravel's 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^[a-z0-9]+(-[a-z0-9]+)*/?$ laravel/public/index.php [L,QSA]
